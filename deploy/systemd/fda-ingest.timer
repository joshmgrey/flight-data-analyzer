[Unit]
Description=Run fda-ingest every 5 minutes

[Timer]
# Every 5 minutes on the wall clock. Keep FDA_POLL_INTERVAL_S in /etc/fda/fda.env in step.
OnCalendar=*:0/5
AccuracySec=5s
# Catch up once after the machine (or WSL) was off at a scheduled time.
Persistent=true
Unit=fda-ingest.service

[Install]
WantedBy=timers.target
