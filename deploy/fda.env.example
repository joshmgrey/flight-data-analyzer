# Flight Data Analyzer runtime configuration.
# setup.sh copies this to /etc/fda/fda.env (mode 600) and fills in DATABASE_URL.
# Never commit the real file: it holds the database password and OpenSky secret.

DATABASE_URL=postgresql://fda:CHANGE_ME@localhost:5432/flightdata

# Optional OpenSky API client (Account page -> API client). Leave unset for anonymous
# access: 400 credits/day, so the poll interval must stay at 300 s or more.
#OPENSKY_CLIENT_ID=
#OPENSKY_CLIENT_SECRET=

# Must match the timer in deploy/systemd/fda-ingest.timer (OnCalendar).
FDA_POLL_INTERVAL_S=300

# Days of raw data to keep before purging.
FDA_RETENTION_DAYS=30

# lamin,lomin,lamax,lomax. Default is ~45 km around ACY.
#FDA_BBOX=39.05,-75.05,39.85,-74.10

FDA_LOG_LEVEL=INFO
